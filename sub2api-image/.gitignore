# Generated by Cargo
# will have compiled files and executables
/target/
**/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Compiled artifacts produced during local builds
**/*.rlib
**/*.rmeta
*.crate

# Rust analyzer / IDE caches
.rust-analyzer/
rust-project.json

# Coverage artifacts (grcov, tarpaulin, llvm-cov)
*.profraw
*.profdata
/coverage/
tarpaulin-report.html
cobertura.xml
lcov.info

# Criterion benchmark output
/criterion/

# Flamegraph / perf output
flamegraph.svg
perf.data
perf.data.old

# cargo-expand / cargo-asm temporary files
expanded.rs

# Environment & secrets
.env
.env.*
!.env.example

# Editors / IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
